{
  "name": "cad-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable design workflows and local project playground",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:playground": "npm run dev --workspace @design-workbench/playground",
    "check:playground": "npm run check --workspace @design-workbench/playground",
    "build:playground": "npm run build --workspace @design-workbench/playground",
    "test:playground": "npm run test --workspace @design-workbench/playground",
    "dev:simulator": "npm run dev:playground",
    "check:simulator": "npm run check:playground",
    "build:simulator": "npm run build:playground",
    "test:simulator": "npm run test:playground"
  }
}
